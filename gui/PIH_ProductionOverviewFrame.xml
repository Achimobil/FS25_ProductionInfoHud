<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="pihProductionOverviewFrame">
    <GuiElement profile="pih_menuContentContainer">
        <Text profile="pih_dialogTitle" id="dialogTitleText" position="25px -10px"/>

        <SmoothList profile="pih_overviewList" id="overviewList" listSectionHeader="section">
            <ListItem profile="pih_overviewListItem">
                <Bitmap profile="pih_listItemIcon" name="icon"/>
                <Text profile="fs25_pricesProductListItemName" name="title"/>
                <Text profile="fs25_pricesProductListItemStorage" name="value"/>
            </ListItem>
            <ListItem profile="fs25_pricesProductListSection" name="section">
                <Text profile="fs25_pricesProductListSectionTitle" name="title"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="pih_overviewListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="overviewList"/>
        </ThreePartBitmap>

        <Text profile="pih_summaryText" id="summaryKeptText" position="514px -100px"/>
        <Text profile="pih_summaryText" id="summaryDistributedText" position="514px -122px"/>
        <Text profile="pih_summaryText" id="summarySoldText" position="514px -144px"/>
        <Text profile="pih_summaryText" id="summaryConsumedText" position="514px -166px"/>
        <Text profile="pih_summaryText" id="summaryRestText" position="514px -188px"/>
        <Text profile="pih_summaryText" id="summaryAreaText" position="514px -210px"/>
        <Text profile="pih_legendText" text="Orange = Verbrauch über Konverter (Alternative)" position="514px -232px"/>

        <SmoothList profile="pih_detailList" id="detailList" listSectionHeader="detailSection">
            <ListItem profile="pih_detailListItem">
                <Bitmap profile="pih_detailListIcon" name="icon"/>
                <Text profile="pih_detailListItemName" name="title"/>
                <Text profile="pih_priceListItemValue" name="value"/>
            </ListItem>
            <ListItem profile="fs25_pricesProductListSection" name="detailSection">
                <Text profile="fs25_pricesProductListSectionTitle" name="title"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="pih_detailListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="detailList"/>
        </ThreePartBitmap>
    </GuiElement>

    <GUIProfiles>
        <Profile name="pih_menuContentContainer" extends="fs25_menuContentContainer" with="anchorStretchingYCenter pivotTopCenter">
            <position value="-310px -25px"/>
            <absoluteSizeOffset value="0px 110px"/>
        </Profile>
        <Profile name="pih_dialogTitle" extends="ingameMenuFrameHeaderText" with="anchorTopLeft">
            <width value="1200px"/>
            <textSize value="32px"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="pih_priceListItemValue" extends="fs25_textDarkHighlight" with="anchorStretchingYRight">
            <position value="-62px 0px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="pih_overviewList" extends="fs25_pricesProductList" with="anchorStretchingYLeft pivotTopLeft">
            <width value="396px"/>
            <absoluteSizeOffset value="0px 86px"/>
            <position value="65px -96px"/>
        </Profile>
        <Profile name="pih_overviewListSliderBox" extends="fs25_pricesProductListSliderBox" with="anchorTopLeft">
            <position value="474px -96px"/>
        </Profile>
        <Profile name="pih_detailList" extends="fs25_pricesPriceListFull" with="anchorStretchingYLeft pivotTopLeft">
            <width value="750px"/>
            <absoluteSizeOffset value="0px 242px"/>
            <position value="514px -252px"/>
        </Profile>
        <Profile name="pih_detailListSliderBox" extends="fs25_pricesPriceSliderBoxFull" with="anchorStretchingYLeft pivotTopLeft">
            <absoluteSizeOffset value="0px 242px"/>
            <position value="1277px -252px"/>
        </Profile>
        <Profile name="pih_summaryText" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="750px"/>
            <textBold value="true"/>
        </Profile>
        <Profile name="pih_legendText" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="750px"/>
            <textColor value="1 0.6 0 1"/>
        </Profile>
        <Profile name="pih_overviewListItem" extends="fs25_pricesProductListItem">
            <height value="44px"/>
        </Profile>
        <Profile name="pih_detailListItem" extends="fs25_pricesPriceListItem">
            <height value="64px"/>
        </Profile>
        <Profile name="pih_listItemIcon" extends="fs25_pricesProductListItemIcon">
            <size value="32px 32px"/>
        </Profile>
        <Profile name="pih_detailListIcon" extends="fs25_pricesProductListItemIcon">
            <size value="56px 56px"/>
        </Profile>
        <Profile name="pih_detailListItemName" extends="fs25_pricesPriceListItemName">
            <position value="72px 0px"/>
        </Profile>
    </GUIProfiles>
</GUI>
