<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="pihProductionOverviewFrame">
    <GuiElement profile="fs25_menuContentContainer">
        <SmoothList profile="pih_overviewList" id="overviewList" listSectionHeader="section">
            <ListItem profile="fs25_pricesProductListItem">
                <Text profile="fs25_pricesProductListItemName" name="title"/>
                <Text profile="fs25_pricesProductListItemStorage" name="value"/>
            </ListItem>
            <ListItem profile="fs25_pricesProductListSection" name="section">
                <Text profile="fs25_pricesProductListSectionTitle" name="title"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="fs25_pricesProductListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="overviewList"/>
        </ThreePartBitmap>

        <Text profile="pih_summaryText" id="summaryKeptText" position="-63px -60px"/>
        <Text profile="pih_summaryText" id="summaryDistributedText" position="-63px -82px"/>
        <Text profile="pih_summaryText" id="summarySoldText" position="-63px -104px"/>
        <Text profile="pih_summaryText" id="summaryConsumedText" position="-63px -126px"/>
        <Text profile="pih_summaryText" id="summaryRestText" position="-63px -148px"/>

        <SmoothList profile="pih_detailList" id="detailList" listSectionHeader="detailSection">
            <ListItem profile="fs25_pricesPriceListItem">
                <Text profile="fs25_pricesPriceListItemName" name="title"/>
                <Text profile="pih_priceListItemValue" name="value"/>
            </ListItem>
            <ListItem profile="fs25_pricesProductListSection" name="detailSection">
                <Text profile="fs25_pricesProductListSectionTitle" name="title"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="pih_detailListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="detailList"/>
        </ThreePartBitmap>
    </GuiElement>

    <GUIProfiles>
        <Profile name="pih_priceListItemValue" extends="fs25_textDarkHighlight" with="anchorStretchingYRight">
            <position value="-62px 0px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="pih_overviewList" extends="fs25_pricesProductList" with="anchorStretchingYLeft">
            <width value="396px"/>
            <position value="25px -56px"/>
        </Profile>
        <Profile name="pih_detailList" extends="fs25_pricesPriceList" with="anchorStretchingYRight">
            <width value="820px"/>
            <absoluteSizeOffset value="0px 190px"/>
            <position value="-63px -190px"/>
        </Profile>
        <Profile name="pih_detailListSliderBox" extends="fs25_pricesPriceSliderBox" with="anchorStretchingYRight">
            <absoluteSizeOffset value="0px 190px"/>
            <position value="-41px -190px"/>
        </Profile>
        <Profile name="pih_summaryText" extends="fs25_textDefault" with="anchorTopRight">
            <width value="820px"/>
            <textBold value="true"/>
        </Profile>
    </GUIProfiles>
</GUI>
