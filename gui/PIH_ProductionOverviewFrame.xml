<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="pihProductionOverviewFrame">
    <GuiElement profile="fs25_menuContentContainer">
        <GuiElement profile="fs25_subCategoryListContainer" id="overviewListBox">
            <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
            <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>
            <SmoothList profile="fs25_subCategoryList" id="overviewList" startClipperElementName="startClipper" endClipperElementName="endClipper" listSectionHeader="section">
                <ListItem profile="fs25_subCategoryListItem">
                    <Text profile="fs25_textDefault" name="title"/>
                    <Text profile="fs25_textDefault" name="value" textAlignment="right"/>
                </ListItem>
                <ListItem profile="fs25_subCategoryListSectionHeader" name="section">
                    <Text profile="fs25_subCategoryListSectionHeaderTitle" name="title"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="overviewList"/>
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>
